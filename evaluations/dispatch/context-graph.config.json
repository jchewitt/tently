{
  "schemaVersion": 1,
  "repositoryRoot": "./project",
  "repositoryId": "example/dispatch-evaluation",
  "namespace": "https://example.test/dispatch-evaluation/",
  "semanticSources": ["docs"],
  "approvedIntentSources": [],
  "codeRoots": ["src", "test"],
  "contractPatterns": [],
  "evidenceRoots": ["src", "test"],
  "semantic": {
    "provider": "module",
    "providerModule": "../../weftlet/document-only.mjs",
    "providerIdentity": "weftlet-document-only-v1",
    "model": "none-document-links-only",
    "reasoningEffort": "none",
    "promptVersion": "document-control-v1",
    "extractorVersion": "1.1.0",
    "adapterVersion": "1.1.0",
    "ontologyVersion": "1.1.0",
    "minimumConfidence": 0.7,
    "failOnUnresolved": true,
    "concurrency": 1,
    "maxDocuments": 6,
    "maxSourceBytes": 65536,
    "timeoutMs": 120000,
    "retries": 0
  },
  "scip": {
    "version": "0.4.0",
    "command": "bundled-scip-typescript",
    "args": ["index", "--no-global-caches"],
    "sourceProject": { "include": ["src/**/*.ts", "test/**/*.ts"] }
  },
  "ontology": { "backend": "rdf", "toolVersion": "rdf-record-v1" },
  "runtimeEvidence": [],
  "storagePath": ".context-graph"
}
