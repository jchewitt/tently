{
  "name": "@weftlet/toolkit",
  "version": "0.1.1",
  "description": "Evidence-backed context graphs for AI development agents: product intent, contracts, code, tests and runtime behavior",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "runtime-check.mjs",
    "runtime-check.d.mts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "examples/generic-typescript",
    "templates/context-graph-development",
    "third-party-tools.json",
    "examples/pipeline",
    "docs"
  ],
  "bin": {
    "weftlet": "dist/cli.js",
    "toolkit": "dist/cli.js",
    "weftlet-mcp": "dist/mcp.js",
    "context-graph": "dist/cli.js",
    "context-graph-mcp": "dist/mcp.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "node runtime-check.mjs && node scripts/clean-build.mjs && pnpm --filter @weftlet/core build && tsc -p tsconfig.json",
    "context-graph": "tsx src/cli.ts",
    "hydrate": "tsx src/cli.ts hydrate --ref HEAD",
    "mcp": "tsx src/mcp.ts",
    "ontology:build": "tsx src/cli.ts ontology compile",
    "scip:index": "scip-typescript index --pnpm-workspaces --no-global-caches",
    "test": "node runtime-check.mjs && pnpm --filter @weftlet/core test && vitest run",
    "test:watch": "vitest",
    "context-graph:licenses": "node scripts/generate-third-party-notices.mjs",
    "context-graph:licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "context-graph:pack:check": "node scripts/check-publication.mjs",
    "context-graph:publication-check": "pnpm build && pnpm test && pnpm govern && pnpm inventory:check && pnpm context-graph:licenses:check && pnpm context-graph:pack:check",
    "inventory:update": "node scripts/update-inventory.mjs",
    "inventory:check": "node scripts/update-inventory.mjs --check",
    "release:prepare": "pnpm context-graph:publication-check && node scripts/release.mjs --prepare",
    "release:publish": "node scripts/release.mjs --publish",
    "govern": "tsx src/cli.ts govern --policy architecture.policy.json --output .context-graph/architecture-report.json",
    "weftlet": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchewitt/weftlet.git"
  },
  "dependencies": {
    "@comunica/query-sparql": "5.4.1",
    "@weftlet/core": "workspace:^",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@sourcegraph/scip-typescript": "0.4.0",
    "import-meta-resolve": "4.2.0",
    "n3": "2.7.2",
    "rdf-validate-shacl": "0.6.5",
    "sparqljs": "3.7.4"
  },
  "devDependencies": {
    "@types/n3": "1.26.1",
    "@types/node": "20.19.11",
    "@typescript-eslint/parser": "8.72.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "jscpd": "5.4.1",
    "tsx": "4.20.5",
    "typescript": "5.5.4",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.18.2",
  "x-extraction-modifications": "Standalone workspace, runtime assets, scripts, and destination metadata; see docs/extraction-manifest.json.",
  "peerDependencies": {
    "@typescript-eslint/parser": "8.72.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "jscpd": "5.4.1"
  },
  "peerDependenciesMeta": {
    "dependency-cruiser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "jscpd": {
      "optional": true
    }
  }
}
